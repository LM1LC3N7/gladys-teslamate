{
  "name": "gladys-teslamate",
  "version": "0.1.0",
  "private": true,
  "description": "Gladys Assistant external integration for TeslaMate, the self-hosted Tesla data logger: battery, range, charge, doors, tyres and state of each car, read from the local MQTT broker TeslaMate publishes to. Read only. Unofficial, not affiliated with Tesla or TeslaMate.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-teslamate.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
